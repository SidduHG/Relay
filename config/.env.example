# Postgres — POSTGRES_USER is the initdb bootstrap role. Official Postgres
# images always make it a superuser with BYPASSRLS, so it must never be
# what the app connects as: row-level security is unconditionally skipped
# for both superusers and BYPASSRLS roles, no matter the table's policy.
# Verified directly — see infra/postgres/init/01-app-role.sql.
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
POSTGRES_DB=relay
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# What apps/api and apps/worker connect as day to day — restricted,
# subject to RLS. Created by infra/postgres/init/01-app-role.sql.
DATABASE_URL=postgresql+asyncpg://relay_app:relay_app@postgres:5432/relay

# Migrations only (see migrations/env.py). Needs real DDL privileges the
# app role deliberately doesn't have.
DATABASE_ADMIN_URL=postgresql+asyncpg://relay:relay@postgres:5432/relay

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
# Must be 32+ bytes (HS256's own floor, RFC 7518 §3.2) — Settings
# enforces this at boot. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=change-me-in-production-this-needs-to-be-at-least-32-bytes-long
API_ENV=development
LOG_LEVEL=INFO

# Worker
WORKER_CONCURRENCY=10
WORKER_ID=worker-1
